<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
  <Target Name="Restore" />
  <Target Name="Build">
    <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)&quot; -B &quot;$(MSBuildProjectDirectory)\out\cmake&quot; -G &quot;Visual Studio 18 2026&quot; -A x64" />
    <Exec Command="cmake --build &quot;$(MSBuildProjectDirectory)\out\cmake&quot; --config $(Configuration) --parallel 4" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\GUI\Native3DGSViewer.GUI.vcxproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=x64" />
    <Touch Files="$(MSBuildProjectDirectory)\GUI\MainWindow.xaml.cpp" Condition="Exists('$(MSBuildProjectDirectory)\GUI\Generated Files\MainWindow.xaml.g.hpp')" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\GUI\Native3DGSViewer.GUI.vcxproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64;Native3DGSSecondPass=true" />
  </Target>
</Project>
