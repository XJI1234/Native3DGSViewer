#version 450
layout(local_size_x = 128) in;
layout(set = 0, binding = 0, std430) buffer Prefix { uint prefix[]; };
layout(set = 0, binding = 1, std430) readonly buffer Sums { uint sums[]; };
layout(push_constant) uniform Params { uint count; uint groups; uint shift; } p;
void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index < p.count)
        prefix[index] += sums[index / 128u];
}
