<Window
    x:Class="Native3DGSCloud.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="#FFF7F8FA">
        <Grid x:Name="ConnectionPage" RowDefinitions="64,*">
            <Grid Background="White" Padding="20,0">
                <TextBlock Text="3DGS Cloud Viewer" FontSize="17" FontWeight="SemiBold" Foreground="#FF18212B" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="1" CornerRadius="6" Padding="32" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="连接云端渲染引擎" FontSize="24" FontWeight="SemiBold" Foreground="#FF18212B" />
                    <TextBlock Text="模型留在服务器，本机只接收画面。连接后将检查服务状态与访问权限。" TextWrapping="Wrap" Foreground="#FF66717D" />
                    <TextBox x:Name="AddressBox" Header="服务器地址" PlaceholderText="例如 10.129.4.104" AutomationProperties.Name="服务器地址" />
                    <TextBox x:Name="PortBox" Header="服务端口（不是 SSH 端口）" Text="8046" AutomationProperties.Name="服务端口" />
                    <PasswordBox x:Name="TokenBox" Header="访问令牌" PlaceholderText="由服务器管理员提供" AutomationProperties.Name="访问令牌" />
                    <CheckBox x:Name="HttpsBox" Content="使用 HTTPS（推荐）" IsChecked="True" />
                    <CheckBox x:Name="PrivateHttpBox" Content="允许可信私网 HTTP 调试（图像和令牌不加密）" />
                    <Button x:Name="ConnectButton" Content="检查并连接" HorizontalAlignment="Stretch" MinHeight="40" />
                    <TextBlock x:Name="ConnectionStatus" Text="尚未连接" TextWrapping="Wrap" Foreground="#FF66717D" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="ViewerPage" RowDefinitions="Auto,*,44" Visibility="Collapsed">
            <Grid Grid.Row="0" Background="White" Padding="20,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Text="3DGS Cloud Viewer" FontSize="17" FontWeight="SemiBold" Foreground="#FF18212B" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ComboBox x:Name="ModelsBox" Width="230" PlaceholderText="选择云端模型" AutomationProperties.Name="云端模型" />
                        <Button x:Name="OpenButton" Content="打开" MinHeight="36" />
                        <Button x:Name="CloseButton" Content="关闭" MinHeight="36" IsEnabled="False" />
                        <Button x:Name="FitButton" Content="适配" MinHeight="36" IsEnabled="False" />
                        <Button x:Name="ResetButton" Content="重置" MinHeight="36" IsEnabled="False" />
                        <CheckBox x:Name="FlipYBox" Content="反转 Y · 倒置观察" AutomationProperties.Name="反转Y，球坐标基准不变" />
                        <CheckBox x:Name="PrefetchBox" Content="预渲染" IsChecked="True" />
                        <ComboBox x:Name="PrefetchDepthBox" SelectedIndex="0" Width="110" AutomationProperties.Name="预渲染范围，低5档，中10档，高15档">
                            <ComboBoxItem Content="低 · 5 档" />
                            <ComboBoxItem Content="中 · 10 档" />
                            <ComboBoxItem Content="高 · 15 档" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ComboBox x:Name="QualityBox" Width="148" SelectedIndex="3" AutomationProperties.Name="画质">
                            <ComboBoxItem Content="RGBA · 无损" />
                            <ComboBoxItem Content="JPEG 95" />
                            <ComboBoxItem Content="JPEG 90" />
                            <ComboBoxItem Content="JPEG 85" />
                        </ComboBox>
                    <Button x:Name="DisconnectButton" Content="重新连接" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="16,0,16,12" Background="#FFFAFBFC">
                <ScrollViewer x:Name="SceneHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="True" AutomationProperties.Name="模型画布，方向键旋转，滚轮缩放">
                    <Grid x:Name="SceneGrid" Background="Transparent">
                        <Image x:Name="SceneImage" Stretch="Uniform" />
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="选择云端模型并点击打开" FontSize="16" FontWeight="SemiBold" Foreground="#FF18212B" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Border Background="White" BorderBrush="#FFE2E6EA" BorderThickness="1" CornerRadius="6" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="固定 · 模型居中" FontSize="12" Foreground="#FF66717D" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="LeftButton" Content="←" AutomationProperties.Name="向左旋转" IsEnabled="False" />
                            <Button x:Name="UpButton" Content="↑" AutomationProperties.Name="向上旋转" IsEnabled="False" />
                            <Button x:Name="DownButton" Content="↓" AutomationProperties.Name="向下旋转" IsEnabled="False" />
                            <Button x:Name="RightButton" Content="→" AutomationProperties.Name="向右旋转" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="滚轮缩放 · 拖动旋转" FontSize="12" Foreground="#FF66717D" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="BusyPanel" Background="White" BorderBrush="#FFE2E6EA" BorderThickness="1" CornerRadius="6" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing Width="20" Height="20" IsActive="True" />
                        <TextBlock x:Name="BusyText" Text="正在加载并渲染" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Background="White" Padding="20,0" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#FF66717D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ModelText" Grid.Column="1" FontSize="12" Foreground="#FF66717D" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Grid>
</Window>
